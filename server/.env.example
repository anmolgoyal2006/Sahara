# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
CLIENT_URL=http://localhost:5173

# ── Supabase (Backend / Admin) ────────────────────────────────────────────────
# Get these from: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
# WARNING: This is the service_role secret key — keep it server-side only!
SUPABASE_SECRET_KEY=your_service_role_secret_key_here

# ── ElevenLabs Text-to-Speech ─────────────────────────────────────────────────
# Get your API key from: https://elevenlabs.io → Profile → API Keys
# NEVER put this key in the frontend or in any VITE_* variable.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Voice ID from ElevenLabs voice library.
# Default "Sarah" (EXAVITQu4vr4xnSDxMaL) — calm, clear, works well for elderly UX.
# Browse voices at: https://elevenlabs.io/voice-library
# For Hinglish/Hindi, "Aria" (9BWtsMINqrJLrRacOk9x) or "Meera" also work well.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
